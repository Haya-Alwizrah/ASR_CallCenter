# Copy to .env
HF_TOKEN=hf_your_read_token_here
GROQ_API_KEY=your_groq_api_key_here
GROQ_SUMMARY_MODEL=openai/gpt-oss-20b

# Local inference configuration
MODEL_NAME=small
LANGUAGE=en
DEVICE=auto
COMPUTE_TYPE=auto
BATCH_SIZE=4
NUM_SPEAKERS=2

# Data paths (relative to project directory)
RESULTS_DIR=results
APPTEK_CACHE_DIR=data/apptek_audio

# Streamlit always keeps ASR loaded to avoid reloading per upload.
# This option affects optional CLI operations only.
KEEP_ASR_LOADED=false